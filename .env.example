# Local-dev configuration for the Hayat Ağı stack.
# Copy this file to .env and adjust as needed.

# MongoDB
MONGO_PORT=27017
MONGO_URI=mongodb://mongo:27017/hayat-agi

# AI fusion service
AI_FUSION_PORT=8000

# Set to true to skip HF Hub download and use the keyword-based mock classifier
# (fast dev iteration; classifications are basic but the pipeline runs end-to-end).
CLASSIFIER_MOCK=false

# HF Hub model distribution. Required for real classification.
# Get a token at https://huggingface.co/settings/tokens (read-only scope is enough
# if the model repo is private to the hayat-agi org or your account).
HF_TOKEN=
# Currently a private repo on Berkay's personal HF account. If/when an HF org
# is created, point this at hayat-agi/classifier instead.
HF_MODEL_REPO=bewrkay/classifier
HF_MODEL_FILENAME=multitask_v3.pt
HF_MODEL_REVISION=main

# Shared bearer token between command-center, forwarder, and AI fusion.
# Required in production. Generate: openssl rand -hex 24
# AI service rejects /ingest, /classify, /incidents, /close with 401 if unset
# on the caller side AND set on the AI side. Leave both unset for full open mode.
FUSION_INGEST_TOKEN=

# Fusion forwarder polling cadence
FORWARDER_POLL_MS=5000

# Command-center backend (Express + MongoDB)
# Default 5000. On macOS Sonoma+, AirPlay Receiver claims 5000 by default —
# disable it (System Settings → General → AirDrop & Handoff) or set 5001 here.
BACKEND_PORT=5000
# Used to sign JWTs. Must be ≥32 chars, cannot be 'devsecret'/'changeme' —
# backend hard-fails at startup otherwise. Generate: openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-32
# Origin allowed by backend CORS. Match the frontend host.
FRONTEND_URL=http://localhost:5173

# Command-center frontend (React + Vite + nginx)
FRONTEND_PORT=5173
# Vite inlines this at build time — changing it requires `docker compose build`.
VITE_API_BASE_URL=http://localhost:5000/api
