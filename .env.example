# Local-dev configuration for the Hayat Ağı stack.
# Copy this file to .env and adjust as needed.

# MongoDB
MONGO_PORT=27017
MONGO_URI=mongodb://mongo:27017/hayat-agi

# AI fusion service
AI_FUSION_PORT=8000

# Set to true to skip HF Hub download and use the keyword-based mock classifier
# (fast dev iteration; classifications are basic but the pipeline runs end-to-end).
CLASSIFIER_MOCK=false

# HF Hub model distribution. Required for real classification.
# Get a token at https://huggingface.co/settings/tokens (read-only scope is enough
# if the model repo is private to the hayat-agi org or your account).
HF_TOKEN=
# Currently a private repo on Berkay's personal HF account. If/when an HF org
# is created, point this at hayat-agi/classifier instead.
HF_MODEL_REPO=bewrkay/classifier
HF_MODEL_FILENAME=multitask_v3.pt
HF_MODEL_REVISION=main

# Fusion forwarder polling cadence
FORWARDER_POLL_MS=5000
