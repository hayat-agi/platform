# Local-dev configuration for the Hayat Ağı stack.
# Copy this file to .env and adjust as needed.

# MongoDB
MONGO_PORT=27017
MONGO_URI=mongodb://mongo:27017/hayat-agi

# AI fusion service (mock mode by default — no model file needed)
AI_FUSION_PORT=8000

# Fusion forwarder polling cadence
FORWARDER_POLL_MS=5000
